@import url('https://googleapis.com');

:root {
    --bg-gradient: linear-gradient(135deg, #0d0f12, #1a1f29, #131722);
    --card-bg: rgba(30, 41, 59, 0.7);
    --text-color: #f8fafc;
    --text-secondary: #94a3b8;
    --primary-color: #00f2fe;
    --secondary-color: #4facfe;
    --success-color: #00ff87;
    --danger-color: #ff007f;
    --accent-color: #ffd700;
    --shadow: 0 20px 40px rgba(0, 0, 0, 0.5);
    --border-radius: 24px;
}

body.light-theme {
    --bg-gradient: linear-gradient(135deg, #f1f5f9, #e2e8f0, #cbd5e1);
    --card-bg: rgba(255, 255, 255, 0.85);
    --text-color: #0f172a;
    --text-secondary: #475569;
    --primary-color: #3b82f6;
    --success-color: #10b981;
    --danger-color: #ef4444;
    --shadow: 0 15px 30px rgba(0, 0, 0, 0.08);
}

* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
    font-family: 'Cairo', sans-serif;
    transition: background 0.3s, color 0.3s, border-color 0.3s;
}

body {
    background: var(--bg-gradient);
    color: var(--text-color);
    min-height: 100vh;
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 20px;
}

.game-container {
    width: 100%;
    max-width: 480px;
    background: var(--card-bg);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: var(--border-radius);
    padding: 30px;
    box-shadow: var(--shadow);
}

.screen {
    display: none;
    opacity: 0;
    transform: scale(0.96);
    transition: opacity 0.4s ease, transform 0.4s ease;
}

.screen.active {
    display: block;
    opacity: 1;
    transform: scale(1);
}

.game-title {
    font-size: 2.4rem;
    font-weight: 900;
    text-align: center;
    margin-bottom: 8px;
    background: linear-gradient(45deg, var(--primary-color), var(--success-color));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
}

.game-subtitle {
    font-size: 0.95rem;
    text-align: center;
    color: var(--text-secondary);
    margin-bottom: 25px;
    line-height: 1.6;
}

h3 {
    font-size: 1.05rem;
    margin-bottom: 12px;
    color: var(--primary-color);
}

.modes-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 10px;
    margin-bottom: 25px;
}

.mode-btn {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.08);
    padding: 12px;
    border-radius: 14px;
    color: var(--text-color);
    font-weight: 700;
    cursor: pointer;
}

.mode-btn:hover, .mode-btn.active {
    background: linear-gradient(45deg, var(--primary-color), var(--secondary-color));
    color: #fff;
    border-color: transparent;
    box-shadow: 0 8px 20px rgba(0, 242, 254, 0.3);
}

#players-list {
    max-height: 150px;
    overflow-y: auto;
    margin-bottom: 15px;
    padding-right: 5px;
}

.player-input-group {
    margin-bottom: 10px;
}

.player-input {
    width: 100%;
    padding: 12px 15px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 12px;
    color: var(--text-color);
    outline: none;
}

.player-input:focus {
    border-color: var(--primary-color);
}

.primary-btn, .secondary-btn, .success-btn, .danger-btn {
    width: 100%;
    padding: 14px;
    border: none;
    border-radius: 14px;
    font-size: 1.05rem;
    font-weight: 700;
    cursor: pointer;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 8px;
}

.primary-btn {
    background: linear-gradient(45deg, var(--success-color), var(--secondary-color));
    color: #0b0f19;
}

.secondary-btn {
    background: transparent;
    border: 2px dashed var(--primary-color);
    color: var(--primary-color);
    margin-bottom: 25px;
}

.card-wrapper {
    perspective: 1000px;
    margin-bottom: 30px;
}

.elegant-card {
    position: relative;
    background: linear-gradient(135deg, rgba(255,255,255,0.03), rgba(255,255,255,0.01));
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: var(--border-radius);
    padding: 50px 25px;
    min-height: 250px;
    display: flex;
    justify-content: center;
    align-items: center;
    overflow: hidden;
    box-shadow: 0 15px 35px rgba(0,0,0,0.2);
}

.card-glow {
    position: absolute;
    width: 150px;
    height: 150px;
    background: var(--primary-color);
    filter: blur(80px);
    opacity: 0.15;
    top: -20px;
    left: -20px;
    pointer-events: none;
}

.card-content {
    position: relative;
    z-index: 2;
    text-align: center;
    width: 100%;
}

.card-tag {
    display: inline-block;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.15);
    color: var(--accent-color);
    padding: 6px 18px;
    border-radius: 50px;
    font-size: 0.85rem;
    font-weight: 700;
    margin-bottom: 25px;
}

.question-text {
    font-size: 1.3rem;
    line-height: 1.7;
    font-weight: 700;
    word-wrap: break-word;
}

.game-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 20px;
}

.icon-btn {
    background: rgba(255, 255, 255, 0.06);
    border: none;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    color: var(--text-color);
    cursor: pointer;
}

.score-display {
    font-weight: 700;
    color: var(--text-secondary);
}

.turn-announcement {
    text-align: center;
    font-size: 1.2rem;
    margin-bottom: 25px;
}

#current-player-name {
    color: var(--primary-color);
    font-size: 1.5rem;
    font-weight: 900;
    text-shadow: 0 0 15px rgba(0, 242, 254, 0.2);
}

.action-buttons {
    display: flex;
    gap: 15px;
}

.success-btn {
    background: linear-gradient(45deg, var(--primary-color), var(--secondary-color));
    color: #fff;
    flex: 2;
}

.danger-btn {
    background: transparent;
    border: 1px solid var(--danger-color);
    color: var(--danger-color);
    flex: 1;
}

.card-bounce {
    animation: slideCard 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
}

@keyframes slideCard {
    0% { transform: translateY(30px) rotate(-2deg); opacity: 0; }
    100% { transform: translateY(0) rotate(0deg); opacity: 1; }
}

@media (max-width: 480px) {
    .action-buttons { flex-direction: column; }
    .danger-btn { order: 2; }
    .elegant-card { min-height: 220px; padding: 35px 20px; }
}
